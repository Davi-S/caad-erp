{
    "name": "caad-erp-monorepo",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "start": "npm --workspace=backend run build && node backend/dist/trpc/server.js",
        "dev:backend": "npm --workspace=backend run dev",
        "dev:frontend": "npm --workspace=frontend run dev -- --host",
        "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
        "test": "npm --workspace=backend run test",
        "lint": "oxlint --fix",
        "format": "oxfmt",
        "fix": "oxlint --fix && oxfmt",
        "knip": "knip --fix-type dependencies",
        "build:frontend": "npm --workspace=frontend run build"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "knip": "^6.32.2",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.71.0",
        "tsx": "^4.23.12"
    }
}
